---
import type { Category } from '../../types';
import { getCategoryBookCount } from '../../data';

interface Props {
  category: Category;
}

const { category } = Astro.props;
const count = getCategoryBookCount(category.slug);
---

<a
  href={`/categories/${category.slug}`}
  class="card-cream group relative rounded-[12px] bg-[#f7f4ee] p-6 transition-all duration-300 hover:shadow-[0_4px_20px_0_rgba(0,0,0,0.08)] flex flex-col justify-between"
>
  <div>
    {/* Category Icon & Count */}
    <div class="flex items-center justify-between gap-3 mb-4">
      <div 
        class="w-11 h-11 rounded-[8px] flex items-center justify-center text-[#161015] bg-white border border-[#e5e0d8] shadow-2xs transition-transform group-hover:scale-105"
      >
        <svg class="w-5 h-5 text-[#064c37]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          {category.icon === 'architecture' && <path d="M4 6h16M4 12h16M4 18h16M7 6v12M17 6v12M12 6v12" />}
          {category.icon === 'sparkles' && <path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3Z" />}
          {category.icon === 'cloud' && <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />}
          {category.icon === 'rocket' && <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09zM12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" />}
          {category.icon === 'palette' && <circle cx="12" cy="12" r="10" />}
          {category.icon === 'compass' && <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" />}
          {category.icon === 'trending-up' && <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />}
          {category.icon === 'zap' && <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />}
          {category.icon === 'code' && <path d="m16 18 6-6-6-6M8 6l-6 6 6 6" />}
        </svg>
      </div>

      <span class="text-[12px] font-mono text-[#064c37] font-semibold bg-white px-2.5 py-1 rounded-[60px] border border-[#e5e0d8]">
        {count} {count === 1 ? 'Volume' : 'Volumes'}
      </span>
    </div>

    {/* Name in Fraunces */}
    <h3 class="text-[20px] font-serif font-normal text-[#161015] group-hover:text-[#064c37] transition-colors leading-[1.2]">
      {category.name}
    </h3>

    {/* Description */}
    <p class="text-[13px] text-[#3f383d] mt-2 line-clamp-2 leading-relaxed tracking-[-0.2px]">
      {category.description}
    </p>

    {/* Subcategory Pills */}
    <div class="flex flex-wrap gap-1.5 mt-4">
      {category.subcategories.slice(0, 3).map((sub) => (
        <span class="text-[11px] px-2 py-0.5 rounded-[8px] bg-white text-[#3f383d] border border-[#e5e0d8]">
          {sub}
        </span>
      ))}
    </div>
  </div>

  <div class="mt-6 pt-3.5 border-t border-[#e5e0d8] flex items-center justify-between text-[13px] font-medium text-[#161015] group-hover:text-[#064c37] transition-colors tracking-[-0.25px]">
    <span>Explore Category</span>
    <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
  </div>
</a>
