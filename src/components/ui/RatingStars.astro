---
interface Props {
  rating: number;
  reviewCount?: number;
  size?: 'sm' | 'md' | 'lg';
  showCount?: boolean;
}

const { rating, reviewCount, size = 'sm', showCount = true } = Astro.props;

const starSizes = {
  sm: 'w-3.5 h-3.5',
  md: 'w-4 h-4',
  lg: 'w-5 h-5'
};

const textSizes = {
  sm: 'text-[12px]',
  md: 'text-[14px]',
  lg: 'text-[16px]'
};

const fullStars = Math.floor(rating);
const hasHalfStar = rating % 1 >= 0.4;
const emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
---

<div class="inline-flex items-center gap-1.5" aria-label={`Rating: ${rating} out of 5 stars`}>
  <div class="flex items-center text-[#d97706]">
    {/* Full stars */}
    {Array.from({ length: fullStars }).map((_, i) => (
      <svg class={`${starSizes[size]} fill-current`} viewBox="0 0 20 20" fill="currentColor">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
    ))}

    {/* Half star */}
    {hasHalfStar && (
      <svg class={`${starSizes[size]} fill-current`} viewBox="0 0 20 20">
        <defs>
          <linearGradient id="halfStarGradFable">
            <stop offset="50%" stop-color="currentColor" />
            <stop offset="50%" stop-color="#e5e0d8" stop-opacity="1" />
          </linearGradient>
        </defs>
        <path fill="url(#halfStarGradFable)" d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
    )}

    {/* Empty stars */}
    {Array.from({ length: emptyStars }).map((_, i) => (
      <svg class={`${starSizes[size]} text-[#d8d3c7] fill-current`} viewBox="0 0 20 20" fill="currentColor">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
    ))}
  </div>

  <span class={`font-bold text-[#161015] ${textSizes[size]}`}>
    {rating.toFixed(1)}
  </span>

  {showCount && reviewCount && (
    <span class={`text-[#3f383d]/70 ${textSizes[size]}`}>
      ({reviewCount})
    </span>
  )}
</div>
