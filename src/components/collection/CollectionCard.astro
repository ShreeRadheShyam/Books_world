---
import type { Collection } from '../../types';
import { getEbooksForCollection } from '../../data';
import BookCover3D from '../ebook/BookCover3D.astro';

interface Props {
  collection: Collection;
}

const { collection } = Astro.props;
const books = getEbooksForCollection(collection);
---

<a
  href={`/collections/${collection.slug}`}
  class="group relative overflow-hidden rounded-[24px] bg-white p-7 transition-all duration-300 hover:shadow-[0_8px_30px_0_rgba(0,0,0,0.1)] flex flex-col justify-between border border-[#e5e0d8]"
>
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-[11px] font-mono font-bold tracking-wider uppercase px-3 py-1 rounded-[60px] bg-[#f7f4ee] text-[#064c37] border border-[#e5e0d8]">
        {collection.badge}
      </span>

      <span class="text-[12px] font-mono text-[#3f383d]/70">
        {books.length} Volumes
      </span>
    </div>

    <h3 class="text-[24px] font-serif font-normal text-[#161015] group-hover:text-[#064c37] transition-colors leading-[1.15]">
      {collection.title}
    </h3>

    <p class="text-[14px] text-[#3f383d] mt-2 line-clamp-2 leading-relaxed tracking-[-0.25px]">
      {collection.tagline}
    </p>

    {/* Overlapping mini book covers directly on clean surface */}
    <div class="flex items-center justify-center -space-x-8 py-6 my-1">
      {books.slice(0, 3).map((book, idx) => (
        <div 
          class={`transform transition-transform group-hover:scale-105 duration-300 ${
            idx === 1 ? 'z-20 scale-105' : 'z-10 opacity-95'
          }`}
        >
          <BookCover3D ebook={book} size="sm" />
        </div>
      ))}
    </div>
  </div>

  <div class="pt-4 border-t border-[#e5e0d8] flex items-center justify-between text-[14px] font-medium text-[#161015] group-hover:text-[#064c37] transition-colors tracking-[-0.25px]">
    <span>View Curriculum</span>
    <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
  </div>
</a>
