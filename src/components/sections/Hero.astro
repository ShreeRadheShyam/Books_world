---
import { getFeaturedEbooks, getAllEbooks } from '../../data';
import BookCover3D from '../ebook/BookCover3D.astro';
import MovingBooksMarquee from '../ebook/MovingBooksMarquee.astro';

const featuredBooks = getFeaturedEbooks().slice(0, 3);
const allBooks = getAllEbooks();
---

{/* Full-bleed Fable Forest (#064c37) Band 1 */}
<section class="w-full bg-[#064c37] text-white pt-14 sm:pt-20 lg:pt-24 pb-10 sm:pb-14 overflow-hidden">
  <div class="max-w-[1200px] mx-auto px-6 sm:px-8 lg:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      {/* Left Column: Headline, subtext, white pill CTA */}
      <div class="lg:col-span-7 space-y-6 sm:space-y-8 text-center lg:text-left">
        
        {/* Subtle Pill Tag */}
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-[60px] bg-white/10 text-white/90 text-[12px] font-mono tracking-wider uppercase backdrop-blur-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-[#f7f4ee]"></span>
          <span>A Curated Literary Reading Nook</span>
        </div>

        {/* Display Headline: Fraunces / Heldane 48–72px, weight 400, line-height 0.88 */}
        <h1 class="text-4xl sm:text-6xl lg:text-[72px] font-serif font-normal text-white tracking-tight leading-[0.92] sm:leading-[0.88]">
          The book is the art. Discover independent eBooks.
        </h1>

        {/* Supporting Copy: Inter 18px, weight 400, line-height 1.5, tracking -0.27px */}
        <p class="text-[17px] sm:text-[18px] text-white/85 max-w-[500px] mx-auto lg:mx-0 leading-[1.5] tracking-[-0.27px]">
          A quiet digital sanctuary for battle-tested engineering blueprints, architecture field guides, and solo founder playbooks. 100% direct to creators.
        </p>

        {/* Action: Filled Pill Button — White (60px radius, #ffffff background, Ink #161015 text) */}
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a
            href="/ebooks"
            class="btn-pill-white"
          >
            <span>Explore All Volumes</span>
            <span class="ml-2">&rarr;</span>
          </a>

          <a
            href="/collections"
            class="inline-flex items-center text-[15px] font-medium text-white/90 hover:text-white underline underline-offset-4 tracking-[-0.25px]"
          >
            View Curated Reading Paths
          </a>
        </div>

        {/* Trust Metrics */}
        <div class="pt-8 border-t border-white/15 grid grid-cols-3 gap-6 max-w-lg mx-auto lg:mx-0 text-left">
          <div>
            <p class="text-2xl sm:text-3xl font-serif text-white">18+</p>
            <p class="text-[12px] text-white/70 font-sans tracking-[-0.2px] mt-0.5">Curated Volumes</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-serif text-white">4.9★</p>
            <p class="text-[12px] text-white/70 font-sans tracking-[-0.2px] mt-0.5">Average Rating</p>
          </div>
          <div>
            <p class="text-2xl sm:text-3xl font-serif text-[#f7f4ee]">100%</p>
            <p class="text-[12px] text-white/70 font-sans tracking-[-0.2px] mt-0.5">Direct to Authors</p>
          </div>
        </div>

      </div>

      {/* Right Column: Editorial Artwork & Book Presentation with Organic Floating Physics */}
      <div class="lg:col-span-5 flex justify-center items-center relative py-6">
        
        {/* Floating Dimensional Composition */}
        <div class="relative flex items-center justify-center">
          
          {/* Background Book Left */}
          {featuredBooks[1] && (
            <div class="transform -rotate-8 -translate-x-12 sm:-translate-x-16 translate-y-6 scale-90 opacity-85 hover:opacity-100 transition-all duration-300 z-10 hidden xs:block animate-float-left">
              <a href={`/ebooks/${featuredBooks[1].slug}`}>
                <BookCover3D ebook={featuredBooks[1]} size="sm" />
              </a>
            </div>
          )}

          {/* Foreground Hero Book Center */}
          {featuredBooks[0] && (
            <div class="transform hover:scale-102 transition-transform duration-300 z-20 shadow-[0_12px_40px_rgba(0,0,0,0.55)] animate-float-center">
              <a href={`/ebooks/${featuredBooks[0].slug}`}>
                <BookCover3D ebook={featuredBooks[0]} size="md" />
              </a>
            </div>
          )}

          {/* Background Book Right */}
          {featuredBooks[2] && (
            <div class="transform rotate-8 translate-x-12 sm:translate-x-16 translate-y-6 scale-90 opacity-85 hover:opacity-100 transition-all duration-300 z-10 hidden xs:block animate-float-right">
              <a href={`/ebooks/${featuredBooks[2].slug}`}>
                <BookCover3D ebook={featuredBooks[2]} size="sm" />
              </a>
            </div>
          )}

        </div>

      </div>

    </div>
  </div>

  {/* Full-bleed Moving Books Shelf — Continuous Horizontal Marquee */}
  <div class="mt-14 sm:mt-20 pt-8 border-t border-white/15">
    <div class="max-w-[1200px] mx-auto px-6 sm:px-8 lg:px-10 mb-2 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2 h-2 rounded-full bg-[#f7f4ee] animate-pulse"></span>
        <span class="text-[12px] font-mono tracking-widest uppercase text-white/85">
          Live Reading Shelf • 18 Independent Editions
        </span>
      </div>
      <div class="hidden sm:flex items-center gap-2 text-[12px] font-mono text-white/60">
        <span>Hover to inspect & pause</span>
        <span>•</span>
        <span>Click for verified author preview</span>
      </div>
    </div>

    <MovingBooksMarquee
      books={allBooks}
      direction="left"
      speed="normal"
      theme="forest"
      showDetails={true}
    />
  </div>
</section>

