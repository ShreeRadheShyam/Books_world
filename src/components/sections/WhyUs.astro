---
const pillars = [
  {
    title: '100% Direct-To-Creator',
    description: 'We never take a percentage of book sales or withhold author earnings. Visitors purchase directly on the creator’s verified sales domain.',
    badge: 'DIRECT'
  },
  {
    title: 'Vetted Practitioner Craft',
    description: 'Zero low-effort AI regurgitations. Every volume is penned by active Staff architects, startup founders, and distinguished engineers.',
    badge: 'CRAFT'
  },
  {
    title: 'DRM-Free, Forever Yours',
    description: 'Authors deliver clean PDF, ePub, and GitHub repositories directly to your inbox. You own your books without proprietary reader lock-in.',
    badge: 'OPEN'
  },
  {
    title: 'Editorial Discovery',
    description: 'No algorithm clutter. We hand-curate high-impact technical and career literature that delivers immediate clarity and compound ROI.',
    badge: 'CURATED'
  }
];
---

<section id="why-platform" class="py-20 lg:py-24 border-none">
  <div class="max-w-[1200px] mx-auto px-6 sm:px-8 lg:px-10">
    
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="text-[12px] font-mono uppercase tracking-widest text-[#f7f4ee]/80 font-medium">
        Our Publishing Manifesto
      </span>
      <h2 class="text-3xl sm:text-5xl font-serif font-normal text-white tracking-tight mt-3 leading-[1.05]">
        Why BookskiDuniya exists.
      </h2>
      <p class="text-[16px] text-white/80 mt-3 leading-relaxed tracking-[-0.32px]">
        Built to celebrate independent technical authors, restore literary dignity to digital publishing, and connect discerning readers directly with original creators.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {pillars.map((pillar) => (
        <div class="rounded-[12px] bg-white/10 backdrop-blur-xs p-6 flex flex-col justify-between border border-white/10">
          <div>
            <span class="text-[11px] font-mono text-[#f7f4ee] font-medium tracking-wider uppercase block mb-3">
              {pillar.badge}
            </span>

            <h3 class="text-[20px] font-serif font-normal text-white mb-2 leading-snug">
              {pillar.title}
            </h3>

            <p class="text-[13px] text-white/80 leading-relaxed tracking-[-0.2px]">
              {pillar.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
