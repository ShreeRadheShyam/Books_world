---
import type { Ebook } from '../../types';
import BookCover3D from './BookCover3D.astro';
import { getAllEbooks } from '../../data';

interface Props {
  books?: Ebook[];
  direction?: 'left' | 'right';
  speed?: 'slow' | 'normal' | 'fast';
  theme?: 'forest' | 'cream' | 'sky' | 'char';
  headline?: string;
  subline?: string;
  showDetails?: boolean;
}

const {
  books = getAllEbooks(),
  direction = 'left',
  speed = 'normal',
  theme = 'forest',
  headline,
  subline,
  showDetails = true
} = Astro.props;

// Double the array for seamless infinite marquee loop
const marqueeItems = [...books, ...books];

const speedClass = {
  slow: 'animate-marquee-slow',
  normal: '',
  fast: 'animate-marquee-fast'
}[speed];

const directionClass = direction === 'left' ? 'animate-marquee-left' : 'animate-marquee-right';

const textColors = {
  forest: {
    badge: 'bg-white/10 text-white/90 border-white/20',
    title: 'text-white',
    sub: 'text-white/80',
    cardSub: 'text-white/70',
    price: 'bg-white text-[#064c37]'
  },
  sky: {
    badge: 'bg-black/10 text-[#161015] border-black/10',
    title: 'text-[#161015]',
    sub: 'text-[#161015]/80',
    cardSub: 'text-[#161015]/70',
    price: 'bg-[#161015] text-white'
  },
  cream: {
    badge: 'bg-[#064c37]/10 text-[#064c37] border-[#064c37]/20',
    title: 'text-[#161015]',
    sub: 'text-[#3f383d]',
    cardSub: 'text-[#3f383d]/80',
    price: 'bg-[#292229] text-[#f7f4ee]'
  },
  char: {
    badge: 'bg-white/10 text-white/90 border-white/20',
    title: 'text-white',
    sub: 'text-white/80',
    cardSub: 'text-white/70',
    price: 'bg-white text-[#070607]'
  }
}[theme];
---

<div class="w-full overflow-hidden marquee-track relative py-4 sm:py-6 select-none">
  {headline && (
    <div class="max-w-[1200px] mx-auto px-6 sm:px-8 lg:px-10 mb-4 sm:mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
      <div>
        {subline && (
          <span class={`text-[11px] font-mono uppercase tracking-widest block mb-1 ${textColors.cardSub}`}>
            {subline}
          </span>
        )}
        <h3 class={`text-2xl sm:text-3xl font-serif font-normal tracking-tight ${textColors.title}`}>
          {headline}
        </h3>
      </div>
      <div class="flex items-center gap-2 text-[12px] font-mono opacity-80">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class={textColors.cardSub}>Continuous Shelf • Hover to Pause</span>
      </div>
    </div>
  )}

  {/* Masked Marquee Viewport */}
  <div class="relative w-full overflow-hidden marquee-mask">
    <div class={`${directionClass} ${speedClass} flex items-start py-3`}>
      {marqueeItems.map((ebook, idx) => {
        // Compute sticker badge text
        let stickerBadge = '';
        let stickerColor = 'bg-[#f7f4ee] text-[#161015]';
        if (ebook.badge === 'bestseller') {
          stickerBadge = '★ BESTSELLER';
          stickerColor = 'bg-[#f59e0b] text-[#161015] font-bold';
        } else if (ebook.badge === 'newRelease') {
          stickerBadge = 'NEW EDITION';
          stickerColor = 'bg-[#43a1d7] text-white';
        } else if (ebook.badge === 'featured') {
          stickerBadge = 'STAFF PICK';
          stickerColor = 'bg-[#064c37] text-white';
        } else {
          stickerBadge = `${ebook.rating}★ RATED`;
          stickerColor = 'bg-white/90 text-[#161015] backdrop-blur-xs';
        }

        return (
          <a
            href={`/ebooks/${ebook.slug}`}
            class="moving-book-card group relative shrink-0 mx-3 sm:mx-4 flex flex-col focus:outline-none"
            title={`Read ${ebook.title} by ${ebook.authorId}`}
            aria-label={ebook.title}
          >
            {/* Book Cover Presentation */}
            <div class="relative">
              <BookCover3D ebook={ebook} size="md" />

              {/* Fable-style Sticker / Badge */}
              <div class="absolute top-3 right-2 z-20 pointer-events-none">
                <span class={`inline-block px-2.5 py-1 rounded-[60px] text-[10px] font-mono tracking-wide shadow-md transform -rotate-3 group-hover:rotate-0 transition-transform duration-300 ${stickerColor}`}>
                  {stickerBadge}
                </span>
              </div>

              {/* Hover Quick Action Pill Overlay */}
              <div class="absolute inset-x-3 bottom-4 z-20 opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none flex justify-center">
                <span class="px-4 py-1.5 rounded-[60px] bg-[#161015]/90 text-white text-[12px] font-medium tracking-tight shadow-lg backdrop-blur-xs">
                  Inspect Volume &rarr;
                </span>
              </div>
            </div>

            {/* Book Caption */}
            {showDetails && (
              <div class="mt-3.5 w-[190px] sm:w-[210px] space-y-1">
                <div class="flex items-center justify-between gap-1">
                  <span class={`text-[11px] font-sans truncate font-medium ${textColors.cardSub}`}>
                    {ebook.authorId.replace('-', ' ').replace(/\b\w/g, l => l.toUpperCase())}
                  </span>
                  <span class={`text-[11px] font-mono px-2 py-0.5 rounded-[60px] font-semibold shrink-0 ${textColors.price}`}>
                    ${ebook.price}
                  </span>
                </div>
                <h4 class={`text-[15px] font-serif font-normal truncate leading-tight group-hover:underline ${textColors.title}`}>
                  {ebook.title}
                </h4>
              </div>
            )}
          </a>
        );
      })}
    </div>
  </div>
</div>
