---
// Superhuman Ultra-Clean & Minimal Editorial Navigation
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isBookLanding = currentPath.includes('10xAiTomorrow') || currentPath.includes('10xAITomorrow');
---

<div id="nav-wrapper" class="sticky top-0 z-50 w-full transition-all duration-300">
  
  {/* TOP ANNOUNCEMENT BANNER: Slender, Elegant Editorial Ticker */}
  <div 
    id="top-announcement-bar" 
    class="w-full bg-[#34161c] text-white py-1.5 px-4 text-xs font-[460] relative z-20 border-b border-[#d4c7ff]/15 transition-all duration-300"
  >
    <div class="max-w-[1240px] mx-auto flex items-center justify-between gap-3">
      
      {/* Left announcement text */}
      <div class="flex items-center gap-2.5 mx-auto md:mx-0">
        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-white/10 text-[10px] font-bold text-[#d4c7ff] tracking-wider uppercase border border-white/10 shadow-xs">
          <span class="w-1.5 h-1.5 rounded-full bg-[#d4c7ff] animate-pulse"></span>
          NEW RELEASE
        </span>
        <span class="text-white/90 text-[12px] tracking-tight truncate max-w-[220px] sm:max-w-md lg:max-w-none">
          <span class="font-semibold text-white">10× AI Tomorrow</span><span class="hidden sm:inline"> is live &mdash; DRM-free, $0.90</span>
        </span>
      </div>

      {/* Right Action & Dismiss */}
      <div class="hidden sm:flex items-center gap-3 shrink-0">
        {isBookLanding ? (
          <button 
            type="button" 
            data-open-buy-modal
            class="group inline-flex items-center gap-1.5 text-[#d4c7ff] hover:text-white text-[11.5px] font-semibold tracking-wide transition-colors cursor-pointer"
          >
            <span>Get Complete Edition &bull; $0.90 USD</span>
            <span class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
          </button>
        ) : (
          <a 
            href="/10xAiTomorrow"
            class="group inline-flex items-center gap-1.5 text-[#d4c7ff] hover:text-white text-[11.5px] font-semibold tracking-wide transition-colors"
          >
            <span>Read Field Guide</span>
            <span class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
          </a>
        )}

        <div class="h-3 w-px bg-white/20"></div>

        {/* Dismiss button */}
        <button 
          id="dismiss-announcement-btn"
          type="button"
          class="text-white/60 hover:text-white p-0.5 rounded-md hover:bg-white/10 transition-colors cursor-pointer"
          aria-label="Dismiss announcement"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

    </div>
  </div>

  {/* MAIN FROSTED EDITORIAL NAVBAR */}
  <header 
    id="site-nav" 
    class="w-full h-[64px] bg-[#f7f5f0]/90 backdrop-blur-xl saturate-150 border-b border-[#292827]/[0.07] transition-all duration-200"
  >
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 h-full flex items-center justify-between gap-4">
      
      {/* BRAND / LOGO LOCKUP */}
      <div class="flex items-center gap-3 shrink-0">
        <a href="/" class="flex items-center gap-3 group focus:outline-none" aria-label="BookskiDuniya Digital Library">
          
          {/* Custom Faceted Monogram Icon */}
          <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-gradient-to-br from-[#421d24] via-[#2f131a] to-[#1a090d] border border-[#d4c7ff]/30 flex items-center justify-center text-white shadow-xs group-hover:scale-105 group-hover:border-[#d4c7ff]/60 transition-all duration-300 relative overflow-hidden shrink-0">
            <div class="absolute inset-0 bg-gradient-to-t from-transparent via-white/5 to-white/20 pointer-events-none"></div>
            <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[#d4c7ff] group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
              <line x1="9" y1="7" x2="16" y2="7"></line>
              <line x1="9" y1="11" x2="14" y2="11"></line>
            </svg>
          </div>

          {/* Typography */}
          <div class="flex flex-col">
            <div class="flex items-center gap-2">
              <span class="text-[16px] sm:text-[17px] font-[550] tracking-tight text-[#292827] group-hover:text-[#421d24] transition-colors whitespace-nowrap">
                BookskiDuniya
              </span>
              {isBookLanding ? (
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-[#714cb6]/10 text-[#714cb6] text-[10px] font-bold tracking-wider uppercase border border-[#714cb6]/20 whitespace-nowrap">
                  10× Tomorrow
                </span>
              ) : (
                <span class="hidden sm:inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-[#421d24]/8 text-[#421d24] text-[10px] font-bold tracking-wider uppercase border border-[#421d24]/15 whitespace-nowrap">
                  LIBRARY
                </span>
              )}
            </div>
            <span class="hidden sm:block text-[9.5px] font-[460] tracking-[0.12em] text-[#666666] uppercase -mt-0.5 whitespace-nowrap">
              {isBookLanding ? 'Field Guide' : 'Press & Library'}
            </span>
          </div>

        </a>
      </div>

      {/* CENTER FLOATING PILL DOCK NAVIGATION (Desktop) */}
      <nav class="hidden md:flex items-center shrink-0" aria-label="Main Navigation">
        <div class="flex items-center gap-1 bg-[#292827]/[0.035] hover:bg-[#292827]/[0.05] p-1 rounded-full border border-[#292827]/[0.06] transition-colors shadow-inner-xs">
          
          {isBookLanding ? (
            <>
              <a href="#top" class="nav-pill-link">
                Overview
              </a>
              <a href="#contents" class="nav-pill-link">
                14 Chapters
              </a>
              <a href="#jump" class="nav-pill-link">
                The Jump
              </a>
              <a href="#morning" class="nav-pill-link">
                Scenarios
              </a>
              <a href="#action" class="nav-pill-link">
                Checklists
              </a>
            </>
          ) : (
            <>
              <a href="#library" class="nav-pill-link">
                The Library
              </a>
              <a href="#spotlight" class="nav-pill-link">
                Spotlight
              </a>
              <a href="#standards" class="nav-pill-link">
                Standards
              </a>
            </>
          )}

        </div>
      </nav>

      {/* RIGHT SIDE ACTIONS & CTAS */}
      <div class="flex items-center gap-2.5 shrink-0">
        
        {/* Back Link or Dedicated Page Switcher */}
        {isBookLanding ? (
          <a 
            href="/"
            class="hidden sm:inline-flex items-center gap-1 px-3 py-1.5 rounded-full text-xs font-[460] text-[#666666] hover:text-[#292827] hover:bg-black/[0.03] transition-colors whitespace-nowrap shrink-0"
          >
            <span>&larr;</span>
            <span>Library</span>
          </a>
        ) : (
          <a 
            href="/10xAiTomorrow"
            class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold text-[#714cb6] hover:bg-[#714cb6]/8 border border-[#714cb6]/20 transition-all whitespace-nowrap shrink-0"
          >
            <span>10× AI Edition &rarr;</span>
          </a>
        )}

        {/* Primary CTA Button: Superhuman Signature Tactile Pill */}
        {isBookLanding ? (
          <button
            type="button"
            data-open-buy-modal
            class="relative group overflow-hidden inline-flex items-center gap-2 whitespace-nowrap shrink-0 bg-[#421d24] hover:bg-[#301319] text-white text-xs font-[500] px-4 py-2 h-[38px] rounded-full shadow-xs hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 cursor-pointer ring-1 ring-[#421d24]/30"
          >
            <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/15 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-out pointer-events-none"></span>
            
            <svg class="w-3.5 h-3.5 text-[#d4c7ff] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            
            <span>Get Field Guide</span>
            <span class="px-1.5 py-0.5 rounded-full bg-white/20 text-[10.5px] font-bold text-[#d4c7ff]">
              $0.90
            </span>
          </button>
        ) : (
          <a
            href="/10xAiTomorrow"
            class="relative group overflow-hidden inline-flex items-center gap-2 whitespace-nowrap shrink-0 bg-[#421d24] hover:bg-[#301319] text-white text-xs font-[500] px-4 py-2 h-[38px] rounded-full shadow-xs hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 ring-1 ring-[#421d24]/30"
          >
            <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/15 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700 ease-out pointer-events-none"></span>
            <span>Open 10× AI Guide</span>
            <span class="text-[#d4c7ff] group-hover:translate-x-0.5 transition-transform">&rarr;</span>
          </a>
        )}

        {/* Mobile Menu Toggle Button */}
        <button
          id="mobile-nav-toggle"
          type="button"
          class="md:hidden p-2 rounded-xl text-[#292827] hover:bg-black/5 active:scale-95 focus:outline-none transition-transform cursor-pointer border border-[#292827]/10"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <svg id="menu-icon-bars" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6" stroke-linecap="round"></line>
            <line x1="3" y1="12" x2="21" y2="12" stroke-linecap="round"></line>
            <line x1="3" y1="18" x2="21" y2="18" stroke-linecap="round"></line>
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>

      </div>

    </div>

    {/* MOBILE NAVIGATION DRAWER */}
    <div 
      id="mobile-nav-dropdown" 
      class="hidden md:hidden bg-[#f7f5f0]/98 backdrop-blur-2xl border-b border-[#292827]/10 px-6 py-5 space-y-3 shadow-xl transition-all duration-300"
    >
      <div class="space-y-1">
        {isBookLanding ? (
          <>
            <a href="#top" class="mobile-nav-link">Overview</a>
            <a href="#contents" class="mobile-nav-link">14 Chapters</a>
            <a href="#jump" class="mobile-nav-link">The Jump</a>
            <a href="#morning" class="mobile-nav-link">Scenarios</a>
            <a href="#action" class="mobile-nav-link">Checklists</a>
            <div class="pt-3 border-t border-[#292827]/10 flex flex-col gap-2">
              <a href="/" class="text-xs font-semibold text-[#714cb6] flex items-center gap-1.5 py-1">
                <span>&larr;</span> Return to Library Home
              </a>
              <button
                type="button"
                data-open-buy-modal
                class="w-full btn-primary-wine text-xs py-2.5 rounded-full flex items-center justify-center gap-2 mt-1"
              >
                <span>Download Complete Book</span>
                <span class="px-2 py-0.5 rounded-full bg-white/20 text-[10px] font-bold">$0.90 USD</span>
              </button>
            </div>
          </>
        ) : (
          <>
            <a href="#library" class="mobile-nav-link">The Library</a>
            <a href="#spotlight" class="mobile-nav-link">Spotlight: 10× AI Tomorrow</a>
            <a href="#standards" class="mobile-nav-link">Curation Standards</a>
            <div class="pt-3 border-t border-[#292827]/10 flex flex-col gap-2">
              <a 
                href="/10xAiTomorrow" 
                class="w-full btn-primary-wine text-xs py-2.5 rounded-full flex items-center justify-center gap-2"
              >
                <span>Read 10× AI Guide</span>
                <span>&rarr;</span>
              </a>
            </div>
          </>
        )}
      </div>

    </div>
  </header>

</div>

<style>
  /* Segmented Nav Pill Styling */
  .nav-pill-link {
    display: inline-flex;
    align-items: center;
    padding: 5px 13px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 460;
    color: rgba(41, 40, 39, 0.85);
    text-decoration: none;
    white-space: nowrap;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-pill-link:hover {
    color: #421d24;
    background-color: #ffffff;
    box-shadow: 0 1px 3px rgba(41, 40, 39, 0.08);
    transform: translateY(-0.5px);
  }

  .mobile-nav-link {
    display: block;
    padding: 8px 12px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 460;
    color: #292827;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .mobile-nav-link:hover {
    background-color: rgba(41, 40, 39, 0.04);
    color: #714cb6;
  }

  .shadow-inner-xs {
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.04);
  }
</style>

<script>
  // Mobile drawer toggle
  const toggle = document.getElementById('mobile-nav-toggle');
  const dropdown = document.getElementById('mobile-nav-dropdown');
  const bars = document.getElementById('menu-icon-bars');
  const close = document.getElementById('menu-icon-close');

  if (toggle && dropdown && bars && close) {
    toggle.addEventListener('click', () => {
      const isClosed = dropdown.classList.contains('hidden');
      if (isClosed) {
        dropdown.classList.remove('hidden');
        bars.classList.add('hidden');
        close.classList.remove('hidden');
        toggle.setAttribute('aria-expanded', 'true');
      } else {
        dropdown.classList.add('hidden');
        bars.classList.remove('hidden');
        close.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });

    dropdown.querySelectorAll('a, button').forEach(link => {
      link.addEventListener('click', () => {
        dropdown.classList.add('hidden');
        bars.classList.remove('hidden');
        close.classList.add('hidden');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Dismiss top announcement bar
  const dismissBtn = document.getElementById('dismiss-announcement-btn');
  const announcementBar = document.getElementById('top-announcement-bar');

  if (dismissBtn && announcementBar) {
    if (sessionStorage.getItem('bd_announcement_dismissed') === 'true') {
      announcementBar.style.display = 'none';
    }

    dismissBtn.addEventListener('click', () => {
      announcementBar.style.opacity = '0';
      announcementBar.style.transform = 'translateY(-100%)';
      setTimeout(() => {
        announcementBar.style.display = 'none';
        sessionStorage.setItem('bd_announcement_dismissed', 'true');
      }, 250);
    });
  }

  // Elevation shadow on scroll
  const siteNav = document.getElementById('site-nav');
  if (siteNav) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 20) {
        siteNav.classList.add('shadow-md', 'bg-[#f7f5f0]/95');
        siteNav.classList.remove('bg-[#f7f5f0]/90');
      } else {
        siteNav.classList.remove('shadow-md', 'bg-[#f7f5f0]/95');
        siteNav.classList.add('bg-[#f7f5f0]/90');
      }
    }, { passive: true });
  }
</script>
