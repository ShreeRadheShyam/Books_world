---
// Adaptive Superhuman Midnight Wine (#421d24) Full-bleed site footer
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isBookLanding = currentPath.includes('10xAiTomorrow') || currentPath.includes('10xAITomorrow');
---

<footer class="w-full bg-[#421d24] text-white py-12 sm:py-20">
  <div class="max-w-[1200px] mx-auto px-6 sm:px-8 lg:px-10">
    
    {/* Brand row — always full width */}
    <div class="mb-10 sm:mb-12">
      <a href="/" class="inline-flex items-center gap-2.5 text-white group mb-3">
        <div class="w-8 h-8 rounded-full border border-white/30 bg-white/10 flex items-center justify-center text-xs font-bold text-[#d4c7ff] group-hover:border-[#d4c7ff] transition-colors">
          {isBookLanding ? '10×' : 'BD'}
        </div>
        <span class="text-lg font-[460] tracking-tight">
          {isBookLanding ? '10× Tomorrow · Field Guide' : 'BookskiDuniya'}
        </span>
      </a>
      <p class="text-[13px] font-[460] text-white/70 leading-relaxed max-w-sm">
        {isBookLanding 
          ? 'A field guide for what actually changes — and what doesn\'t.'
          : 'An independent digital library. Direct to creators. No platform cut.'}
      </p>
      <div class="pt-3 flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-white/80 text-xs font-[460]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#d4c7ff]"></span>
          <span>{isBookLanding ? 'Published September 2026' : 'Independent Press & Archive'}</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 text-white/80 text-xs font-[460]">
          <span>DRM-Free Formats</span>
        </span>
      </div>
    </div>

    {/* Link columns grid */}
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 gap-8">

      {isBookLanding ? (
        /* Book Page Footer Columns */
        <>
          <div class="space-y-3">
            <h4 class="text-[14px] font-[700] text-white tracking-wider uppercase">The Jump &amp; Aftermath</h4>
            <ul class="space-y-3 text-[14px] font-[460] text-white/70">
              <li><a href="#contents" class="hover:text-white transition-colors">01 Defining the Jump</a></li>
              <li><a href="#contents" class="hover:text-white transition-colors">02 Where AI Stands Today</a></li>
              <li><a href="#contents" class="hover:text-white transition-colors">03 Four Roads to a Leap</a></li>
              <li><a href="#morning" class="hover:text-white transition-colors">04 Science &amp; Medicine</a></li>
              <li><a href="#morning" class="hover:text-white transition-colors">05 Work: Ladder &amp; Floor</a></li>
              <li><a href="#morning" class="hover:text-white transition-colors">06 Software &amp; Security</a></li>
              <li><a href="#morning" class="hover:text-white transition-colors">07 Truth &amp; Trust</a></li>
            </ul>
          </div>

          <div class="space-y-3">
            <h4 class="text-[14px] font-[700] text-white tracking-wider uppercase">Governance &amp; Action</h4>
            <ul class="space-y-3 text-[14px] font-[460] text-white/70">
              <li><a href="#hard" class="hover:text-white transition-colors">08 The Control Problem</a></li>
              <li><a href="#hard" class="hover:text-white transition-colors">09 Who Holds The Power</a></li>
              <li><a href="#hard" class="hover:text-white transition-colors">10 The Skeptic's Chapter</a></li>
              <li><a href="#action" class="hover:text-white transition-colors">11 Three Scenarios</a></li>
              <li><a href="#action" class="hover:text-white transition-colors">12 For Individuals</a></li>
              <li><a href="#action" class="hover:text-white transition-colors">13 For Organizations</a></li>
              <li><a href="#action" class="hover:text-white transition-colors">14 For Policymakers</a></li>
            </ul>
          </div>

          <div class="space-y-3">
            <h4 class="text-[14px] font-[700] text-white tracking-wider uppercase">Navigation</h4>
            <ul class="space-y-3 text-[14px] font-[460] text-white/70">
              <li>
                <button type="button" data-open-buy-modal class="text-left text-[#d4c7ff] hover:underline cursor-pointer">
                  Buy Field Guide ($0.90 USD) &rarr;
                </button>
              </li>
              <li>
                <button type="button" data-open-modal="method" class="text-left hover:text-white cursor-pointer">
                  How To Read This Guide
                </button>
              </li>
              <li><a href="#top" class="hover:text-white transition-colors">Return To Top ↑</a></li>
              <li>
                <a href="/" class="text-[#d4c7ff] hover:underline flex items-center gap-1 pt-1">
                  <span>&larr; Return to Library</span>
                </a>
              </li>
            </ul>
          </div>
        </>
      ) : (
        /* General Library Home Footer Columns */
        <>
          <div class="space-y-3">
            <h4 class="text-[14px] font-[700] text-white tracking-wider uppercase">The Library</h4>
            <ul class="space-y-3 text-[14px] font-[460] text-white/70">
              <li><a href="#library" class="hover:text-white transition-colors">All Publications</a></li>
              <li><a href="/10xAiTomorrow" class="text-[#d4c7ff] hover:underline font-semibold">10× AI Tomorrow &rarr;</a></li>
              <li><a href="#spotlight" class="hover:text-white transition-colors">Spotlight</a></li>
              <li><a href="#standards" class="hover:text-white transition-colors">Standards</a></li>
            </ul>
          </div>

          <div class="space-y-3">
            <h4 class="text-[14px] font-[700] text-white tracking-wider uppercase">Reading Tracks</h4>
            <ul class="space-y-3 text-[14px] font-[460] text-white/70">
              <li><a href="/10xAiTomorrow" class="hover:text-white transition-colors">Vol 1: Cognitive Frontiers</a></li>
              <li><span class="opacity-40">Vol 2: Distributed Systems</span></li>
              <li><span class="opacity-40">Vol 3: Systems Governance</span></li>
            </ul>
          </div>

          <div class="space-y-3">
            <h4 class="text-[14px] font-[700] text-white tracking-wider uppercase">Get It</h4>
            <ul class="space-y-3 text-[14px] font-[460] text-white/70">
              <li>
                <a href="/10xAiTomorrow" class="text-[#d4c7ff] hover:underline">
                  10× AI Tomorrow &rarr;
                </a>
              </li>
              <li>
                <button type="button" data-open-buy-modal class="text-left hover:text-white cursor-pointer">
                  Buy Now &bull; $0.90 USD
                </button>
              </li>
              <li><a href="#hero" class="hover:text-white transition-colors">Back to top &uarr;</a></li>
            </ul>
          </div>
        </>
      )}

    </div>

    {/* Footer Bottom Bar */}
    <div class="mt-10 sm:mt-16 pt-6 border-t border-white/15 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-[12px] font-[460] text-white/50">
      <p>&copy; {new Date().getFullYear()} BookskiDuniya. All rights reserved.</p>

      <div class="flex flex-wrap items-center gap-4">
        <a href="/" class="hover:text-white transition-colors">Library Home</a>
        <span>&bull;</span>
        <a href="/10xAiTomorrow" class="hover:text-white transition-colors">10xAiTomorrow</a>
        <span>&bull;</span>
        <button type="button" data-open-buy-modal class="hover:text-white transition-colors cursor-pointer">
          Buy ($0.90)
        </button>
      </div>
    </div>

  </div>
</footer>
