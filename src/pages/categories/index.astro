---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryCard from '../../components/category/CategoryCard.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { getAllCategories } from '../../data';
import { generateBreadcrumbSchema } from '../../utils/seo';

const categories = getAllCategories();

const breadcrumbs = [
  { label: 'Categories' }
];

const schema = generateBreadcrumbSchema([
  { name: 'Home', item: '/' },
  { name: 'Categories', item: '/categories' }
]);
---

<BaseLayout
  title="All Categories — BookskiDuniya"
  description="Explore our curated technical and business eBook categories: System Design, AI & LLMs, Cloud Infrastructure, Micro-SaaS, and more."
  schema={schema}
>
  <div class="w-full bg-[#f7f4ee] py-10 sm:py-16">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      
      <Breadcrumbs items={breadcrumbs} />

      <div class="mb-12 text-center max-w-2xl mx-auto">
        <span class="text-[12px] font-mono font-bold tracking-widest uppercase text-[#064c37]">
          Disciplines & Focus Areas
        </span>
        <h1 class="text-4xl sm:text-5xl font-serif font-normal text-[#161015] tracking-tight mt-2 leading-[0.95]">
          Browse by Category
        </h1>
        <p class="text-[16px] text-[#3f383d] mt-3 leading-relaxed tracking-[-0.32px]">
          Targeted, practitioner-authored digital books organized by engineering discipline, product craft, and career roadmap.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {categories.map((category) => (
          <CategoryCard category={category} />
        ))}
      </div>

    </div>
  </div>
</BaseLayout>
