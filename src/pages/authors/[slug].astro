---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EbookCard from '../../components/ebook/EbookCard.astro';
import FeaturedEbookCard from '../../components/ebook/FeaturedEbookCard.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { getAllAuthors, getEbooksByAuthor, getEbookBySlug } from '../../data';
import { generateAuthorSchema, generateBreadcrumbSchema, SITE_URL } from '../../utils/seo';

export function getStaticPaths() {
  const authors = getAllAuthors();
  return authors.map((author) => ({
    params: { slug: author.slug },
    props: { author }
  }));
}

const { author } = Astro.props;
const authorBooks = getEbooksByAuthor(author.id);

const featuredBook = author.featuredBookSlug
  ? getEbookBySlug(author.featuredBookSlug)
  : authorBooks[0];

const otherBooks = authorBooks.filter((b) => b.id !== featuredBook?.id);

const totalReviews = authorBooks.reduce((sum, b) => sum + b.reviewCount, 0);
const avgRating = authorBooks.length > 0
  ? (authorBooks.reduce((sum, b) => sum + b.rating, 0) / authorBooks.length).toFixed(2)
  : '5.0';

const breadcrumbs = [
  { label: 'Authors', href: '/authors' },
  { label: author.name }
];

const authorSchema = generateAuthorSchema(author, authorBooks);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Home', item: '/' },
  { name: 'Authors', item: '/authors' },
  { name: author.name, item: `/authors/${author.slug}` }
]);

const pageUrl = `${SITE_URL}/authors/${author.slug}`;
---

<BaseLayout
  title={`${author.name} — Author & Creator Profile`}
  description={author.shortBio}
  canonical={pageUrl}
  type="profile"
  schema={[authorSchema, breadcrumbSchema]}
>
  {/* Author Hero Band on Fable Forest (#064c37) */}
  <section class="w-full bg-[#064c37] text-white py-16 sm:py-20">
    <div class="max-w-[1200px] mx-auto px-6 sm:px-8 lg:px-10">
      
      <div class="text-white/80">
        <Breadcrumbs items={breadcrumbs} />
      </div>

      <div class="flex flex-col md:flex-row items-center md:items-start gap-8 mt-4">
        
        <img
          src={author.avatar}
          alt={author.name}
          class="w-32 h-32 sm:w-40 sm:h-40 rounded-full object-cover border-4 border-white shadow-2xl shrink-0"
        />

        <div class="flex-1 text-center md:text-left space-y-3">
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
            <h1 class="text-4xl sm:text-5xl font-serif font-normal text-white tracking-tight leading-[0.95]">
              {author.name}
            </h1>
            <span class="inline-flex items-center px-3 py-1 rounded-[60px] text-[12px] font-mono font-semibold bg-white text-[#161015]">
              Verified Creator
            </span>
          </div>

          <p class="text-[17px] font-medium text-white/90">
            {author.title} {author.company ? `• ${author.company}` : ''}
          </p>

          <p class="text-[15px] text-white/80 max-w-2xl leading-relaxed tracking-[-0.25px]">
            {author.bio}
          </p>

          {/* Socials & Location */}
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-5 pt-2 text-[13px] text-white/85">
            {author.location && (
              <span class="flex items-center gap-1.5">
                <span>📍</span>
                <span>{author.location}</span>
              </span>
            )}

            {author.socials.website && (
              <a href={author.socials.website} target="_blank" rel="noopener noreferrer" class="underline hover:text-white font-medium">
                Official Website ↗
              </a>
            )}
            {author.socials.twitter && (
              <a href={author.socials.twitter} target="_blank" rel="noopener noreferrer" class="underline hover:text-white font-medium">
                Twitter / X ↗
              </a>
            )}
            {author.socials.github && (
              <a href={author.socials.github} target="_blank" rel="noopener noreferrer" class="underline hover:text-white font-medium">
                GitHub ↗
              </a>
            )}
          </div>

        </div>

      </div>

      {/* Metrics */}
      <div class="mt-12 pt-6 border-t border-white/15 grid grid-cols-3 gap-6 max-w-md text-left">
        <div>
          <p class="text-2xl sm:text-3xl font-serif text-white">{authorBooks.length}</p>
          <p class="text-[12px] text-white/70 font-sans mt-0.5">Published Volumes</p>
        </div>
        <div>
          <p class="text-2xl sm:text-3xl font-serif text-white">{avgRating}★</p>
          <p class="text-[12px] text-white/70 font-sans mt-0.5">Average Rating</p>
        </div>
        <div>
          <p class="text-2xl sm:text-3xl font-serif text-white">{totalReviews.toLocaleString()}+</p>
          <p class="text-[12px] text-white/70 font-sans mt-0.5">Reader Reviews</p>
        </div>
      </div>

    </div>
  </section>

  {/* Author Publications on Paper Cream (#f7f4ee) */}
  <section class="w-full bg-[#f7f4ee] text-[#161015] py-16 sm:py-24">
    <div class="max-w-[1200px] mx-auto px-6 sm:px-8 lg:px-10 space-y-16">
      
      {/* Featured Book */}
      {featuredBook && (
        <div>
          <h2 class="text-2xl sm:text-3xl font-serif font-normal text-[#161015] mb-6">
            Featured Publication
          </h2>
          <FeaturedEbookCard ebook={featuredBook} />
        </div>
      )}

      {/* All Books */}
      {otherBooks.length > 0 && (
        <div class="space-y-6">
          <h2 class="text-2xl sm:text-3xl font-serif font-normal text-[#161015]">
            More from {author.name} ({otherBooks.length})
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {otherBooks.map((book) => (
              <EbookCard ebook={book} />
            ))}
          </div>
        </div>
      )}

    </div>
  </section>
</BaseLayout>
